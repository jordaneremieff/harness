{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "view": {
          "enum": [
            "overview",
            "revisions"
          ]
        },
        "windowDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "required": []
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": "string",
          "pattern": "^[-_A-Za-z0-9]{4,256}$",
          "maxLength": 256
        }
      },
      "required": [
        "cursor"
      ]
    }
  ]
}
