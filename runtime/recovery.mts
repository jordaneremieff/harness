export const recoveryHtml = `<!doctype html><html lang="en-AU"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Harness management</title><link rel="stylesheet" href="/runtime/recovery.css"><main><h1>Harness management</h1><p>This service works independently of conversations and the main browser app. Changes are deliberate and never replay automatically.</p><nav><button data-operation="health">Health</button><button data-operation="diagnostics">Diagnostics</button><button data-operation="lifecycle.status">Browser status</button><button data-operation="lifecycle.start">Start browser</button><button data-operation="release.status">Release status</button><button data-operation="release.rollback">Roll back browser</button><button data-operation="evolution.status">Harness status</button><button data-operation="upstream.status">Pi status</button><button data-operation="auth.status">Accounts</button></nav><section><h2>Configuration</h2><label>Owner <select id="target"><option value="pi">Pi preferences</option><option value="runtime">Runtime settings</option></select></label><button id="read-config">Read</button><label>Supported values <textarea id="config" rows="9" spellcheck="false">{}</textarea></label><button id="validate-config">Validate</button><button id="save-config">Apply changes</button><button id="repair-config">Replace invalid document</button><p>Existing processes retain their settings. Runtime network settings take effect at the next deliberate service restart.</p></section><section><h2>Account access</h2><label>Provider <input id="provider" autocomplete="off"></label><label>Method <select id="auth-type"><option value="oauth">OAuth</option><option value="api_key">API key</option></select></label><button id="login">Start login</button><button id="auth-poll">Check login</button><button id="auth-cancel">Cancel login</button><div id="auth-events"></div><form id="auth-form" hidden><label id="prompt-label" for="answer">Answer</label><input id="answer" autocomplete="off"><button>Submit answer</button></form></section><section><h2>Project resources and trust</h2><label>Absolute project folder <input id="cwd" autocomplete="off"></label><button id="resources">Inspect resources</button><button id="trust-read">Read trust</button><button id="trust-set">Trust this folder</button><button id="packages">List packages</button></section><section><h2>Maintenance</h2><label>Operation <select id="maintenance"><option value="release.stage">Stage current source</option><option value="release.switch">Switch browser release</option><option value="upstream.update">Update Pi</option><option value="evolution.promotion-plan">Plan promotion</option><option value="evolution.promote-local">Promote locally</option></select></label><label>Release identity or space-separated slices <input id="selection" autocomplete="off"></label><button id="maintain">Run selected operation</button></section><h2>Result</h2><pre id="result" tabindex="0" role="status"></pre></main><script src="/runtime/recovery.js" defer></script></html>`;
export const recoveryCss = `:root{color-scheme:light dark;font-family:system-ui}body{margin:0}main{max-width:800px;margin:auto;padding:24px}section{border-top:1px solid #888;padding:12px 0}nav{display:flex;flex-wrap:wrap;gap:8px}label{display:block;margin:8px 0}input,textarea,select,button{font:inherit;padding:10px;max-width:100%;box-sizing:border-box}input,textarea{width:100%}button{cursor:pointer;margin:4px}pre{white-space:pre-wrap;overflow-wrap:anywhere}a{display:block;padding:8px 0}`;
export const recoveryJs = `const $=id=>document.getElementById(id);let digest,flow,prompt;
async function call(request){let value;try{const response=await fetch('/runtime/operation',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({protocol:'harness.runtime/1',request})});value=await response.json();}catch{value={ok:false,error:{message:'The response is unconfirmed. Read the owning status before another change.',uncertain:true}};}$('result').textContent=JSON.stringify(value,null,2);return value;}
for(const button of document.querySelectorAll('[data-operation]'))button.onclick=()=>{const operation=button.dataset.operation;if(['release.rollback','lifecycle.start'].includes(operation)&&!confirm(button.textContent+'?'))return;void call({operation});};
$('read-config').onclick=async()=>{const result=await call({operation:'config.inspect',target:$('target').value});if(result.ok){digest=result.value.digest;$('config').value=JSON.stringify(result.value.values||{},null,2);}};$('target').onchange=()=>{digest=undefined;};
for(const [id,operation]of [['validate-config','config.validate'],['save-config','config.apply']])$(id).onclick=async()=>{try{const values=JSON.parse($('config').value);if(operation==='config.apply'&&!confirm('Apply these configuration values?'))return;const result=await call({operation,target:$('target').value,values,...(digest?{expectedDigest:digest}:{})});if(result.ok&&result.value.snapshot)digest=result.value.snapshot.digest;}catch{$('result').textContent='Enter a JSON object.';}};
$('repair-config').onclick=async()=>{if(!digest){$('result').textContent='Read the invalid configuration first.';return;}if(!confirm('Replace the invalid document with these supported values? The original bytes stay in a private backup. Other original settings are not copied into the replacement.'))return;try{const result=await call({operation:'config.repair',target:$('target').value,values:JSON.parse($('config').value),expectedDigest:digest,confirm:true});if(result.ok)digest=result.value.snapshot.digest;}catch{$('result').textContent='Enter a JSON object.';}};\nfunction auth(value){if(!value.ok)return;flow=value.value.flowId;prompt=value.value.prompt;$('auth-form').hidden=!prompt;$('auth-events').replaceChildren();for(const event of value.value.events||[]){const p=document.createElement('p');p.textContent=event.message||event.userCode||'';$('auth-events').append(p);for(const candidate of [event.url,event.verificationUri,...(event.links||[]).map(x=>x.url)]){if(!candidate)continue;try{const url=new URL(candidate);if(url.protocol!=='https:')continue;const a=document.createElement('a');a.href=url.href;a.rel='noreferrer noopener';a.target='_blank';a.textContent='Open account authorisation';$('auth-events').append(a);}catch{}}}if(prompt){$('prompt-label').textContent=prompt.message;$('answer').type=prompt.type==='secret'?'password':'text';$('answer').value='';if(prompt.options)$('prompt-label').textContent+=' ('+prompt.options.map(x=>x.id+': '+x.label).join(', ')+')';}}
$('login').onclick=async()=>auth(await call({operation:'auth.login',provider:$('provider').value,type:$('auth-type').value}));$('auth-poll').onclick=async()=>{if(flow)auth(await call({operation:'auth.poll',flowId:flow}));};$('auth-cancel').onclick=async()=>{if(flow)await call({operation:'auth.cancel',flowId:flow});flow=prompt=undefined;$('auth-form').hidden=true;};$('auth-form').onsubmit=async event=>{event.preventDefault();if(!flow||!prompt)return;const value=$('answer').value;$('answer').value='';auth(await call({operation:'auth.respond',flowId:flow,promptId:prompt.id,value}));};
$('resources').onclick=()=>call({operation:'resources.inspect',cwd:$('cwd').value});$('packages').onclick=()=>call({operation:'packages.list',cwd:$('cwd').value});$('trust-read').onclick=()=>call({operation:'trust.inspect',cwd:$('cwd').value});$('trust-set').onclick=()=>{if(confirm('Trust project resources in this folder?'))void call({operation:'trust.set',cwd:$('cwd').value,decision:true});};
$('maintain').onclick=()=>{const operation=$('maintenance').value,selection=$('selection').value.trim();if(!confirm('Run '+operation+'?'))return;void call({operation,...(operation==='release.switch'?{releaseId:selection}:{}),...(operation.startsWith('evolution.promotion')||operation==='evolution.promote-local'?{slices:selection.split(/\\s+/).filter(Boolean)}:{})});};void call({operation:'health'});`;
