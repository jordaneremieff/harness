{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["evals/**/*.mts", "extensions/**/*.ts", "extensions/**/*.mts", "operator-ui/**/*.ts", "operator-ui/**/*.mts", "prompts/*.eval.mts", "scripts/**/*.mts", "session-name/**/*.ts", "session-name/**/*.mts", "skills/**/*.mts", "transport/**/*.ts", "transport/**/*.mts"],
  "exclude": ["node_modules"]
}
