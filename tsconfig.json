{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["evals/**/*.mts", "extensions/**/*.ts", "extensions/**/*.mts", "prompts/*.ts", "prompts/*.mts", "scripts/**/*.mts", "skills/**/*.mts", "transport/**/*.ts", "transport/**/*.mts"],
  "exclude": ["node_modules"]
}
