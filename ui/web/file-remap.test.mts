import assert from 'node:assert/strict';
import test from 'node:test';
import {FilesViews} from './files-views.ts';
import {createAppFixture} from './app-fixture.mts';
const {app, HostNode, byId, settle} = await createAppFixture();
type HostNode = InstanceType<typeof HostNode>;
import {createPaneLayout} from './pane-layout.ts';
import {movedWorkspaceFiles} from './file-identity.ts';
import {workspaceTabKey,type FileTab,type Workspace} from '../shared/api.ts';
test('identity remap keeps source and preview views, native ancestors, draft and delayed position ownership',async context=> {
  const tab:FileTab = {kind:'file',rootId:'r',path:'folder/note.md'},preview:FileTab = {...tab,view:'preview'};let workspace:Workspace = {id:'remap',revision:0,conversationLayout:createPaneLayout([tab,preview])};let revision = 0;const writes:string[] = [],positions:string[] = [];
  const manager = new FilesViews(app.stableViews,async(_w,tab)=>({rootId:tab.rootId,path:tab.path,text:'# Disk',revision:{size:6,mtimeMs:1,digest:'a'.repeat(64)}}),()=>workspace,(_w,key)=>positions.push(key),()=>{}, {draft:async()=>({revision:0,draft:null}),put:async(_w,tab,_revision,base,text,encoding)=> {writes.push(tab.path);return {revision:++revision,base,text,encoding};},save:async()=> {throw new Error('unused');}});
  const source = manager.view(workspace,tab),reading = manager.view(workspace,preview),slot = new HostNode('div');byId('workspace').append(slot);app.stableViews().place(source.root,slot as unknown as HTMLElement);app.stableViews().sync();context.after(()=> {app.stableViews().forget(source.root);app.stableViews().forget(reading.root);source.destroy();reading.destroy();slot.remove();});await source.owner.load();await settle();
  const editor = source.editor;assert.ok(editor);const ancestors = [editor.parentNode,editor.parentNode?.parentNode];editor.value = '# Draft';editor.setSelectionRange(2,6,'backward');(editor as unknown as HostNode).dispatch('input');await source.owner.drain();editor.scrollTop = 80;(editor as unknown as HostNode).dispatch('scroll');
  const move = {rootId:'r',from:'folder',to:'renamed'};const release = await manager.prepareMove(workspace.id,move);manager.remap(workspace.id,move);workspace = movedWorkspaceFiles(workspace,move);release();
  const newTab = {...tab,path:'renamed/note.md'},newPreview = {...preview,path:newTab.path};assert.equal(manager.view(workspace,newTab),source);assert.equal(manager.view(workspace,newPreview),reading);assert.equal(source.owner,reading.owner);assert.deepEqual([editor.parentNode,editor.parentNode?.parentNode],ancestors);assert.equal(editor.value,'# Draft');assert.deepEqual([editor.selectionStart,editor.selectionEnd,editor.selectionDirection],[2,6,'backward']);assert.equal(editor.scrollTop,80);assert.equal(editor.getAttribute('aria-label'),newTab.path);
  editor.value = '# New draft';(editor as unknown as HostNode).dispatch('input');await manager.drain();assert.equal(writes.at(-1),newTab.path);assert.deepEqual(positions,[workspaceTabKey(newTab)]);assert.equal(reading.root.querySelector('h1')?.textContent,'New draft');
});
test('closed unacknowledged destination text remains retrievable and guards unload after an identity collision',async context=> {
  const source:FileTab = {kind:'file',rootId:'r',path:'source.md'},destination:FileTab = {...source,path:'destination.md'};
  let workspace:Workspace = {id:'closed-collision',revision:0,conversationLayout:createPaneLayout([source,destination])};const writes:string[] = [];
  const manager = new FilesViews(app.stableViews,async(_w,tab)=>({rootId:tab.rootId,path:tab.path,text:'# Source',revision:{size:8,mtimeMs:1,digest:'a'.repeat(64)}}),()=>workspace,()=>{},()=>{}, {
    draft:async()=>({revision:0,draft:null}),put:async(_w,tab,_revision,base,text,encoding)=> {writes.push(tab.path);if (text === 'Unacknowledged destination') throw new Error('The file is missing.');return {revision:1,base,text,encoding};},save:async()=> {throw new Error('unused');}
  });
  const sourceView = manager.view(workspace,source),destinationView = manager.view(workspace,destination);context.after(()=> {for (const view of [sourceView,destinationView]) {app.stableViews().forget(view.root);view.destroy();}});
  await Promise.all([sourceView.owner.load(),destinationView.owner.load()]);destinationView.owner.edit('Unacknowledged destination');await assert.rejects(destinationView.owner.drain(),/missing/);
  workspace = {...workspace,conversationLayout:createPaneLayout([])};manager.reconcile(workspace,[],[]);await settle();assert.equal(manager.canDispose,false);
  const move = {rootId:'r',from:source.path,to:destination.path};manager.remap(workspace.id,move);manager.remap(workspace.id,move);
  assert.equal(manager.owner(workspace.id,destination),sourceView.owner);assert.equal(sourceView.owner.text,'# Source');assert.deepEqual(manager.retained(workspace.id),[destinationView.owner]);assert.equal(manager.retained()[0].text,'Unacknowledged destination');assert.equal(manager.canDispose,false);assert.deepEqual(manager.scopes(workspace.id),[]);
  const count = writes.length;await manager.drain();await destinationView.owner.load(true);await destinationView.owner.refreshDisk();await destinationView.owner.reread();await destinationView.owner.save();assert.equal(writes.length,count);assert.equal(destinationView.owner.text,'Unacknowledged destination');
  manager.discardRetained(destinationView.owner);assert.equal(manager.retained().length,0);assert.equal(manager.canDispose,true);assert.equal(sourceView.owner.text,'# Source');
});
for (const destinationFirst of [false,true]) test(`identity collision retains both native view pairs and both local texts with destination-first=${destinationFirst}`,async context=> {
  const source:FileTab = {kind:'file',rootId:'r',path:'source.md'},destination:FileTab = {...source,path:'destination.md'},sourcePreview:FileTab = {...source,view:'preview'},destinationPreview:FileTab = {...destination,view:'preview'};
  let workspace:Workspace = {id:`open-collision-${destinationFirst}`,revision:0,conversationLayout:createPaneLayout([source,sourcePreview,destination,destinationPreview])};const writes:string[] = [],positions:string[] = [];
  const manager = new FilesViews(app.stableViews,async(_w,tab)=>({rootId:tab.rootId,path:tab.path,text:'# Base',revision:{size:6,mtimeMs:1,digest:'a'.repeat(64)}}),()=>workspace,(_w,key)=>positions.push(key),()=>{}, {
    draft:async()=>({revision:0,draft:null}),put:async(_w,tab,_revision,base,text,encoding)=> {writes.push(tab.path);return {revision:1,base,text,encoding};},save:async()=> {throw new Error('unused');}
  });
  const ordered = destinationFirst ? [destination,destinationPreview,source,sourcePreview] : [source,sourcePreview,destination,destinationPreview],views = ordered.map(tab=>manager.view(workspace,tab));context.after(()=> {for (const view of views) {app.stableViews().forget(view.root);view.destroy();}});
  const sourceView = manager.view(workspace,source),destinationView = manager.view(workspace,destination),reading = manager.view(workspace,sourcePreview),retainedReading = manager.view(workspace,destinationPreview);
  const sourceSlot = new HostNode('div'),targetSlot = new HostNode('div');byId('workspace').append(sourceSlot,targetSlot);context.after(()=> {sourceSlot.remove();targetSlot.remove();});app.stableViews().place(sourceView.root,sourceSlot as unknown as HTMLElement);app.stableViews().place(destinationView.root,targetSlot as unknown as HTMLElement);app.stableViews().sync();
  await Promise.all(views.map(view=>view.owner.load()));await settle();const editor = sourceView.editor,targetEditor = destinationView.editor;assert.ok(editor);assert.ok(targetEditor);
  targetEditor.scrollTop = 90;(targetEditor as unknown as HostNode).dispatch('scroll');if (!destinationFirst) {editor.scrollTop = 30;(editor as unknown as HostNode).dispatch('scroll');}
  editor.value = '# Source draft';editor.setSelectionRange(2,8,'backward');(editor as unknown as HostNode).dispatch('input');targetEditor.value = '# Destination draft';(targetEditor as unknown as HostNode).dispatch('input');
  const sourceParents = [editor.parentNode,editor.parentNode?.parentNode],targetParents = [targetEditor.parentNode,targetEditor.parentNode?.parentNode];
  manager.remap(workspace.id,{rootId:'r',from:source.path,to:destination.path});workspace = {...workspace,revision:1,conversationLayout:createPaneLayout([destination,destinationPreview])};manager.reconcile(workspace,[destination,destinationPreview],[destination]);
  assert.equal(manager.view(workspace,destination),sourceView);assert.equal(manager.view(workspace,destinationPreview),reading);assert.equal(editor.value,'# Source draft');assert.equal(targetEditor.value,'# Destination draft');assert.deepEqual([editor.parentNode,editor.parentNode?.parentNode],sourceParents);assert.deepEqual([targetEditor.parentNode,targetEditor.parentNode?.parentNode],targetParents);assert.deepEqual([editor.selectionStart,editor.selectionEnd,editor.selectionDirection],[2,8,'backward']);
  assert.equal(destinationView.root.isConnected,true);assert.equal(retainedReading.root.isConnected,true);assert.equal(destinationView.root.hidden,true);assert.equal(targetEditor.readOnly,true);assert.equal(manager.canDispose,false);assert.deepEqual(manager.scopes(workspace.id),[{rootId:'r',files:['destination.md']}]);assert.equal(manager.positions(workspace)[workspaceTabKey(destination)].scrollTop,destinationFirst ? 0 : 30);assert.throws(()=>manager.checkpoint(workspace),/retained draft/);
  await manager.drain();assert.deepEqual(writes,['destination.md']);assert.deepEqual(positions,destinationFirst ? [] : [workspaceTabKey(destination)]);assert.equal(manager.retained()[0].text,'# Destination draft');manager.discardRetained(destinationView.owner);assert.equal(manager.canDispose,true);assert.equal(editor.value,'# Source draft');
});
test('a late displaced-owner draft acknowledgment never releases retained text or restarts its I/O',async context=> {
  const source:FileTab = {kind:'file',rootId:'r',path:'source.md'},destination:FileTab = {...source,path:'destination.md'},workspace:Workspace = {id:'late-collision',revision:0,conversationLayout:createPaneLayout([source,destination])};let acknowledge:(()=>void)|undefined;let writes = 0;
  const manager = new FilesViews(app.stableViews,async(_w,tab)=>({rootId:tab.rootId,path:tab.path,text:'# Base',revision:{size:6,mtimeMs:1,digest:'a'.repeat(64)}}),()=>workspace,()=>{},()=>{}, {
    draft:async()=>({revision:0,draft:null}),put:async(_w,_tab,_revision,base,text,encoding)=> {writes++;await new Promise<void>(resolve=> {acknowledge = resolve;});return {revision:1,base,text,encoding};},save:async()=> {throw new Error('unused');}
  });
  const sourceView = manager.view(workspace,source),targetView = manager.view(workspace,destination);context.after(()=> {manager.discardRetained(targetView.owner);for (const view of [sourceView,targetView]) {app.stableViews().forget(view.root);view.destroy();}});
  await Promise.all([sourceView.owner.load(),targetView.owner.load()]);targetView.owner.edit('# Pending');const pending = targetView.owner.drain();await settle();assert.equal(targetView.owner.persisting,true);
  manager.remap(workspace.id,{rootId:'r',from:source.path,to:destination.path});acknowledge?.();await pending;await targetView.owner.drain();await targetView.owner.save();
  assert.equal(writes,1);assert.equal(targetView.owner.text,'# Pending');assert.equal(targetView.owner.acknowledged,'# Base');assert.equal(targetView.owner.retained,true);assert.equal(manager.canDispose,false);
});
for (const dirty of [false,true]) test(`closed destination retention distinguishes acknowledged local work from clean cached source: dirty=${dirty}`,async context=> {
  const source:FileTab = {kind:'file',rootId:'r',path:'source.md'},destination:FileTab = {...source,path:'destination.md'},workspace:Workspace = {id:`closed-state-${dirty}`,revision:0,conversationLayout:createPaneLayout([source,destination])};let revision = 0;
  const manager = new FilesViews(app.stableViews,async(_w,tab)=>({rootId:tab.rootId,path:tab.path,text:'base',revision:{size:4,mtimeMs:1,digest:'a'.repeat(64)}}),()=>workspace,()=>{},()=>{}, {draft:async()=>({revision:0,draft:null}),put:async(_w,_tab,_revision,base,text,encoding)=>({revision:++revision,base,text,encoding}),save:async()=> {throw new Error('unused');}});
  const moved = manager.view(workspace,source),cached = manager.view(workspace,destination);context.after(()=> {manager.discardRetained(cached.owner);for (const view of [moved,cached]) {app.stableViews().forget(view.root);view.destroy();view.owner.dispose();}});await Promise.all([moved.owner.load(),cached.owner.load()]);if (dirty) {cached.owner.edit('acknowledged draft');await cached.owner.drain();}assert.equal(cached.owner.canDispose,true);
  manager.reconcile(workspace,[source],[source]);await settle();manager.remap(workspace.id,{rootId:'r',from:source.path,to:destination.path});assert.equal(manager.owner(workspace.id,destination),moved.owner);assert.deepEqual(manager.retained(),dirty ? [cached.owner] : []);assert.equal(manager.canDispose,!dirty);assert.equal(cached.owner.text,dirty ? 'acknowledged draft' : 'base');
});
test('rescan bounds open-source reads and never re-reads retained closed owners',async context=> {
  const tabs:FileTab[] = ['a','b','c','closed'].map(path=>({kind:'file',rootId:'r',path}));const workspace:Workspace = {id:'bounded',revision:0,conversationLayout:createPaneLayout(tabs)};let passive = false,active = 0,max = 0;const paths:string[] = [],pending:(()=>void)[] = [];
  const manager = new FilesViews(app.stableViews,async(_w,tab)=> {const source = {rootId:'r',path:tab.path,text:'base',revision:{size:4,mtimeMs:1,digest:'a'.repeat(64)}};if (!passive) return source;paths.push(tab.path);active++;max = Math.max(max,active);await new Promise<void>(resolve=>pending.push(()=> {active--;resolve();}));return source;},()=>workspace,()=>{},()=>{});
  const views = tabs.map(tab=>manager.view(workspace,tab));context.after(()=> {for (const view of views) {app.stableViews().forget(view.root);view.destroy();}});await Promise.all(views.map(view=>view.owner.load()));manager.reconcile(workspace,tabs.slice(0,3),[]);passive = true;
  const refresh = manager.refresh(workspace.id,'r',[],true);await settle();assert.equal(active,2);assert.equal(paths.includes('closed'),false);void views[0]?.owner.refreshDisk();void views[1]?.owner.refreshDisk();pending.shift()?.();pending.shift()?.();await settle();assert.equal(active,2);pending.shift()?.();pending.shift()?.();await settle();assert.equal(active,1);pending.shift()?.();await refresh;assert.equal(max,2);assert.deepEqual(paths,['a','b','a','b','c']);
});
