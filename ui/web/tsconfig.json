{
  "compilerOptions": {
    "target": "ES2023", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "types": [],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "rewriteRelativeImportExtensions": true, "erasableSyntaxOnly": true,
    "rootDir": "..", "outDir": "../dist", "verbatimModuleSyntax": true
  },
  "include": ["./*.ts", "../shared/api.ts"], "exclude": ["./*.test.mts"]
}
