{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "A pi harness with extensions and skills for governed reasoning, continuity, web search, and clipboard history.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=4 \"evals/*.test.mts\" \"evals/subjects/*.test.mts\" \"extensions/*/*.test.mts\" \"operator-ui/*.test.mts\" \"prompts/*.test.mts\" \"scripts/*.test.mts\" \"skills/*/scripts/*.test.mts\" \"transport/*.test.mts\"",
    "test:coverage": "npm test -- --experimental-test-coverage",
    "evals": "node evals/cli.mts",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --error-on-warnings .",
    "typecheck": "tsc -p .",
    "check": "node scripts/check-slices.mts",
    "hooks": "node scripts/publication-scan.mts --install",
    "warmup:jiti": "pi --help --offline --extension extensions/brave/index.ts --extension extensions/statusline/index.ts --extension extensions/clipboard/index.ts --extension extensions/stash/index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extensions"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "4.1.4",
    "tinyrainbow": "3.1.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "vitest-evals": "0.16.1"
  },
  "dependencies": {
    "@earendil-works/chord": "*",
    "@earendil-works/pi-codemode": "*",
    "@earendil-works/pi-durable": "*",
    "@earendil-works/pi-mcp": "*",
    "@earendil-works/pi-schema": "*",
    "htmlparser2": "12.0.0",
    "proper-lockfile": "4.1.2"
  }
}
