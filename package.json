{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "A pi harness with extensions and skills for governed reasoning, continuity, web search, and clipboard history.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "NODE_COMPILE_CACHE=\"${NODE_COMPILE_CACHE:-$PWD/node_modules/.cache/node-compile-cache}\" node --test --test-concurrency=4 --test-timeout=120000 \"evals/*.test.mts\" \"evals/subjects/*.test.mts\" \"extensions/*/*.test.mts\" \"extensions/*/native/web/app/*/*.test.mts\" \"extensions/markdown/native/web/test/*.test.mts\" \"prompts/*.test.mts\" \"scripts/*.test.mts\" \"skills/*/scripts/*.test.mts\" \"transport/*.test.mts\"",
    "test:coverage": "NODE_DISABLE_COMPILE_CACHE=1 npm test -- --experimental-test-coverage",
    "evals": "node evals/cli.mts",
    "lint": "biome check --assist-enabled=false --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc -p .",
    "check": "node scripts/check-slices.mts",
    "hooks": "node scripts/publication-scan.mts --install",
    "warmup:jiti": "node scripts/extension-load-check.mts extensions/*/index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extensions"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.19.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "^5.9.3",
    "vitest": "4.1.12",
    "vitest-evals": "0.16.1"
  },
  "dependencies": {
    "@earendil-works/chord": "*",
    "@earendil-works/pi-codemode": "*",
    "@earendil-works/pi-durable": "*",
    "@earendil-works/pi-mcp": "*",
    "@earendil-works/pi-schema": "*",
    "htmlparser2": "12.0.0",
    "proper-lockfile": "4.1.2"
  }
}
