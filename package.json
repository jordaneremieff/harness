{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "description": "A pi harness with extensions and skills for governed reasoning, continuity, web search, and clipboard history.",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=60 --test-coverage-functions=60 --test-coverage-branches=50 \"evals/*.test.mts\" \"evals/subjects/*.test.mts\" \"extensions/*/*.test.mts\" \"prompts/*.test.mts\" \"scripts/*.test.mts\" \"skills/*/scripts/*.test.mts\"",
    "evals": "node evals/cli.mts",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --error-on-warnings .",
    "typecheck": "tsc -p .",
    "check": "node scripts/check-slices.mts",
    "worktrees": "node scripts/worktrees.mts",
    "worktrees:sync": "node scripts/worktrees.mts sync",
    "worktrees:status": "node scripts/worktrees.mts status",
    "worktrees:hooks": "node scripts/worktrees.mts install-hooks",
    "warmup:jiti": "pi --help --offline --extension extensions/brave/index.ts --extension extensions/statusline/index.ts --extension extensions/clipboard/index.ts --extension extensions/stash/index.ts --extension extensions/subagent/index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "extensions": [
      "./extensions"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.19.0",
    "tinyrainbow": "3.1.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11",
    "vitest-evals": "0.16.1"
  }
}
